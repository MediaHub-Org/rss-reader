{
  "name": "rss-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight local-first RSS/Atom reader with media playback",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:desktop": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run check:desktop",
    "test:e2e": "node scripts/e2e.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "desktop:dev": "tauri dev",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug",
    "icons": "node scripts/make-icons.mjs",
    "proxy": "node server/proxy.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "dompurify": "^3.2.4",
    "events": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
